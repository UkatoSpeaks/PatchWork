# Copy to .env and fill in your key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# One model per agent role. Any LiteLLM model string works; Groq models are
# prefixed "groq/". `patchwork run --solo` only uses CODER_MODEL.
LEAD_MODEL=groq/openai/gpt-oss-120b
CODER_MODEL=groq/openai/gpt-oss-120b
TESTER_MODEL=groq/openai/gpt-oss-120b
# A different model family spreads load across Groq's per-model rate limits.
REVIEWER_MODEL=groq/qwen/qwen3.8-27b

# Fallbacks per role (comma-separated, tried in order) for when a model hits
# its per-day limit (TPD/RPD). The agent keeps its conversation.
LEAD_FALLBACKS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-20b
CODER_FALLBACKS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-20b
TESTER_FALLBACKS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-20b
REVIEWER_FALLBACKS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b

# Agent budgets (each agent in a crew run gets its own budget)
MAX_STEPS_PER_AGENT=25
MAX_TOKENS_PER_RUN=60000
# Cap on completion tokens per LLM call. Groq counts this against your
# tokens-per-minute limit, so keep it small.
MAX_OUTPUT_TOKENS=1024

# Crew: coder retries per run (failing suite or review blockers)
MAX_RETRIES=3

# Test runner. A leading "python" is replaced with the interpreter running
# Patchwork, so pytest from the dev dependencies is found.
TEST_COMMAND=python -m pytest -q --tb=short -p no:cacheprovider
TEST_TIMEOUT_SECONDS=120

# Rate-limit handling (Groq free tier, gpt-oss-120b: 8k tokens/min, 200k tokens/day)
MAX_CONCURRENT_REQUESTS=2
# Per-minute limits: retry (honouring retry-after) until a call has waited
# this many seconds in total. Per-day limits are never retried; see *_FALLBACKS.
LLM_MAX_WAIT_SECONDS=180
# When the per-minute token budget is short: "proportional" waits only for the
# missing tokens to refill (falls back to "full" for a model after a 429),
# "full" waits for the window reset.
THROTTLE_MODE=proportional
