# Copy to .env and fill in your key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# One model per agent role. Any LiteLLM model string works; Groq models are
# prefixed "groq/". Milestone 1 only uses CODER_MODEL.
LEAD_MODEL=groq/llama-3.3-70b-versatile
CODER_MODEL=groq/llama-3.3-70b-versatile
TESTER_MODEL=groq/llama-3.1-8b-instant
REVIEWER_MODEL=groq/llama-3.3-70b-versatile

# Agent budgets
MAX_STEPS_PER_AGENT=25
MAX_TOKENS_PER_RUN=60000
# Cap on completion tokens per LLM call. Groq counts this against your
# tokens-per-minute limit, so keep it small.
MAX_OUTPUT_TOKENS=1024

# Test runner. A leading "python" is replaced with the interpreter running
# Patchwork, so pytest from the dev dependencies is found.
TEST_COMMAND=python -m pytest -q --tb=short -p no:cacheprovider
TEST_TIMEOUT_SECONDS=120

# Rate-limit handling (Groq free tier: ~30 req/min, ~6k tokens/min per model)
MAX_CONCURRENT_REQUESTS=2
LLM_MAX_RETRIES=6
